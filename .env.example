# Local settings for `thyme run`. Copy to .env; it is never uploaded or committed.
# Task-local values in functions/<task>/.env override these and become ctx.secrets.

# RPC for chain reads and --simulate. Any Sepolia RPC works, including a Thyme Gate endpoint.
RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# Address used as ctx.account locally. Set it to your Safe to simulate as it.
SIMULATE_ACCOUNT=0x742d35Cc6634C0532925a3b844Bc454e4438f44e

# Optional. Leave empty to use Thyme's production deployment.
THYME_API_URL=
